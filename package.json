{
  "name": "mutil-skills",
  "version": "0.4.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/g2060308919-star/mutil-skills.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "generate:e2e-schemas": "npm run build && node scripts/generate-e2e-artifact-schemas.mjs",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "e2e:golden": "vitest run --config vitest.e2e.config.ts",
    "verify:e2e-pack": "node scripts/run-e2e-release.mjs pack",
    "verify:e2e-release": "node scripts/run-e2e-release.mjs registry",
    "verify:e2e-public-diagnostic": "node scripts/run-e2e-release.mjs diagnostic",
    "verify:e2e-scale": "node --import tsx scripts/e2e-scale-proof.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "playwright": "1.61.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.0",
    "zod": "^3.25.0"
  }
}
