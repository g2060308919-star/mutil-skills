{
  "name": "mutil-skills",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "generate:e2e-schemas": "npm run build && node scripts/generate-e2e-artifact-schemas.mjs",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "e2e:golden": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "playwright": "1.61.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "zod": "^3.25.0"
  }
}
