{
  "type": "object",
  "properties": {
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "artifactType": {
      "type": "string",
      "const": "browser-preflight"
    },
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "assetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._:-]+(?:\\/[A-Za-z0-9._:-]+)*$"
    },
    "prdRevision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "generationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "keyId": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "type": "string",
            "const": "Ed25519"
          },
          "signedDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "signature": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "issuer",
          "keyId",
          "algorithm",
          "signedDigest",
          "signature"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "artifactType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "schemaVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(?!\\/)(?!.*\\\\)(?!.*:)(?!.*\\/\\/)(?!.*\\/$)(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!(?:.*\\/)?(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:\\/|$))[^\\0/]+(?:\\/[^\\0/]+)*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactId",
          "artifactType",
          "schemaVersion",
          "relativePath",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "graph": {
      "type": "object",
      "properties": {
        "defines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        }
      },
      "required": [
        "defines",
        "references"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "discoveryGrantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "authorityPreflightDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "observedActor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed"
                ]
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "code",
              "status",
              "digest"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "observedIdentity": {
          "type": "object",
          "properties": {
            "identityId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "identityId",
            "digest"
          ],
          "additionalProperties": false
        },
        "actorChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "digest"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        },
        "leaseChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "digest"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        },
        "gatewayChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "digest"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        },
        "sandboxChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "digest"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        }
      },
      "required": [
        "discoveryGrantId",
        "authorityPreflightDigest",
        "observedActor",
        "checks",
        "observedIdentity",
        "actorChecks",
        "leaseChecks",
        "gatewayChecks",
        "sandboxChecks",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "artifactId",
    "artifactType",
    "schemaVersion",
    "engineVersion",
    "assetId",
    "prdRevision",
    "generationId",
    "createdAt",
    "contentDigest",
    "signatures",
    "dependencies",
    "graph",
    "content"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mutil-skills.local/e2e/schemas/browser-preflight.schema.json",
  "title": "browser-preflight artifact",
  "x-e2e-runtime-validation": {
    "required": true,
    "constraints": [
      "contentDigest、Authority 签名、dependency 与 graph 必须由 validateGeneration 校验"
    ]
  }
}
