{
  "type": "object",
  "properties": {
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "artifactType": {
      "type": "string",
      "const": "manual-results"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "assetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._:-]+(?:\\/[A-Za-z0-9._:-]+)*$"
    },
    "prdRevision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "generationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "keyId": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "type": "string",
            "const": "Ed25519"
          },
          "signedDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "signature": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "issuer",
          "keyId",
          "algorithm",
          "signedDigest",
          "signature"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "artifactType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "schemaVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(?!\\/)(?!.*\\\\)(?!.*:)(?!.*\\/\\/)(?!.*\\/$)(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!(?:.*\\/)?(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:\\/|$))[^\\0/]+(?:\\/[^\\0/]+)*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactId",
          "artifactType",
          "schemaVersion",
          "relativePath",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "graph": {
      "type": "object",
      "properties": {
        "defines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        }
      },
      "required": [
        "defines",
        "references"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "string",
                "const": "1.0.0"
              },
              "manualResultId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "runId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "assetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9._:-]+(?:\\/[A-Za-z0-9._:-]+)*$"
              },
              "prdRevision": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "generationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "runtimeInstallationDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "manualProcedureId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "caseIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "minItems": 1,
                "maxItems": 256
              },
              "obligationIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "minItems": 1,
                "maxItems": 256
              },
              "requirementModelDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "executor": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                },
                "required": [
                  "subject",
                  "roles"
                ],
                "additionalProperties": false
              },
              "reviewer": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                },
                "required": [
                  "subject",
                  "roles"
                ],
                "additionalProperties": false
              },
              "startedAt": {
                "type": "string",
                "format": "date-time"
              },
              "finishedAt": {
                "type": "string",
                "format": "date-time"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "unable"
                ]
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "stepId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9._:-]+$"
                    },
                    "instructionDigest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "outcome": {
                      "type": "string",
                      "enum": [
                        "passed",
                        "failed",
                        "unable"
                      ]
                    },
                    "observation": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    },
                    "evidenceDigests": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      },
                      "minItems": 1,
                      "maxItems": 256
                    }
                  },
                  "required": [
                    "stepId",
                    "instructionDigest",
                    "outcome",
                    "observation",
                    "evidenceDigests"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 10000
              },
              "evidenceDigests": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "minItems": 1,
                "maxItems": 10000
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "authorityProof": {
                "type": "object",
                "properties": {
                  "issuer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "keyId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "proofScope": {
                    "type": "string",
                    "const": "local-os-user"
                  },
                  "algorithm": {
                    "type": "string",
                    "const": "Ed25519"
                  },
                  "signedDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "signature": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  },
                  "approvalAssurance": {
                    "type": "object",
                    "properties": {
                      "approvalMode": {
                        "type": "string",
                        "enum": [
                          "local-confirmation",
                          "webauthn"
                        ]
                      },
                      "identityVerified": {
                        "type": "boolean"
                      },
                      "separationOfDutiesVerified": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "approvalMode",
                      "identityVerified",
                      "separationOfDutiesVerified"
                    ],
                    "additionalProperties": false,
                    "default": {
                      "approvalMode": "webauthn",
                      "identityVerified": true,
                      "separationOfDutiesVerified": true
                    }
                  },
                  "executorPresence": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string",
                        "enum": [
                          "executor",
                          "reviewer"
                        ]
                      },
                      "approvalType": {
                        "type": "string",
                        "enum": [
                          "manual-executor",
                          "manual-reviewer"
                        ]
                      },
                      "requiredRole": {
                        "type": "string",
                        "enum": [
                          "e2e-manual-executor",
                          "e2e-manual-reviewer"
                        ]
                      },
                      "subject": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[A-Za-z0-9._:-]+$"
                      },
                      "sessionId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[A-Za-z0-9._:-]+$"
                      },
                      "runId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[A-Za-z0-9._:-]+$"
                      },
                      "installationDigest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      },
                      "draftDigest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      },
                      "origin": {
                        "type": "string",
                        "format": "uri"
                      },
                      "issuedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "expiresAt": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "role",
                      "approvalType",
                      "requiredRole",
                      "subject",
                      "sessionId",
                      "runId",
                      "installationDigest",
                      "draftDigest",
                      "origin",
                      "issuedAt",
                      "expiresAt"
                    ],
                    "additionalProperties": false
                  },
                  "reviewerPresence": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string",
                        "enum": [
                          "executor",
                          "reviewer"
                        ]
                      },
                      "approvalType": {
                        "type": "string",
                        "enum": [
                          "manual-executor",
                          "manual-reviewer"
                        ]
                      },
                      "requiredRole": {
                        "type": "string",
                        "enum": [
                          "e2e-manual-executor",
                          "e2e-manual-reviewer"
                        ]
                      },
                      "subject": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[A-Za-z0-9._:-]+$"
                      },
                      "sessionId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[A-Za-z0-9._:-]+$"
                      },
                      "runId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[A-Za-z0-9._:-]+$"
                      },
                      "installationDigest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      },
                      "draftDigest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      },
                      "origin": {
                        "type": "string",
                        "format": "uri"
                      },
                      "issuedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "expiresAt": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "role",
                      "approvalType",
                      "requiredRole",
                      "subject",
                      "sessionId",
                      "runId",
                      "installationDigest",
                      "draftDigest",
                      "origin",
                      "issuedAt",
                      "expiresAt"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "issuer",
                  "keyId",
                  "proofScope",
                  "algorithm",
                  "signedDigest",
                  "signature",
                  "executorPresence",
                  "reviewerPresence"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "schemaVersion",
              "manualResultId",
              "runId",
              "assetId",
              "prdRevision",
              "generationId",
              "runtimeInstallationDigest",
              "manualProcedureId",
              "caseIds",
              "obligationIds",
              "requirementModelDigest",
              "executor",
              "reviewer",
              "startedAt",
              "finishedAt",
              "outcome",
              "steps",
              "evidenceDigests",
              "expiresAt",
              "authorityProof"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        }
      },
      "required": [
        "results"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "artifactId",
    "artifactType",
    "schemaVersion",
    "engineVersion",
    "assetId",
    "prdRevision",
    "generationId",
    "createdAt",
    "contentDigest",
    "signatures",
    "dependencies",
    "graph",
    "content"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mutil-skills.local/e2e/schemas/manual-results.schema.json",
  "title": "manual-results artifact",
  "x-e2e-runtime-validation": {
    "required": true,
    "constraints": [
      "contentDigest、Authority 签名、dependency 与 graph 必须由 validateGeneration 校验"
    ]
  }
}
