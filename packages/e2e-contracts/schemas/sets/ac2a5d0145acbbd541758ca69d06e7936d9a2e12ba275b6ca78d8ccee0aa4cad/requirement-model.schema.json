{
  "type": "object",
  "properties": {
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "artifactType": {
      "type": "string",
      "const": "requirement-model"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "assetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._:-]+(?:\\/[A-Za-z0-9._:-]+)*$"
    },
    "prdRevision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "generationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "keyId": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "type": "string",
            "const": "Ed25519"
          },
          "signedDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "signature": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "issuer",
          "keyId",
          "algorithm",
          "signedDigest",
          "signature"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "artifactType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "schemaVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(?!\\/)(?!.*\\\\)(?!.*:)(?!.*\\/\\/)(?!.*\\/$)(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!(?:.*\\/)?(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:\\/|$))[^\\0/]+(?:\\/[^\\0/]+)*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactId",
          "artifactType",
          "schemaVersion",
          "relativePath",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "graph": {
      "type": "object",
      "properties": {
        "defines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        }
      },
      "required": [
        "defines",
        "references"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "modelRevision": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reqId": {
                "type": "string",
                "minLength": 1
              },
              "contractNodeIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "revision": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "actors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "entities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "preconditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ruleId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "contractNodeIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    },
                    "category": {
                      "type": "string",
                      "enum": [
                        "business",
                        "permission",
                        "validation",
                        "state",
                        "error",
                        "visual"
                      ]
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceRefs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    },
                    "certainty": {
                      "type": "string",
                      "enum": [
                        "explicit",
                        "confirmed-inference"
                      ]
                    },
                    "oracleIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "maxItems": 1
                    }
                  },
                  "required": [
                    "ruleId",
                    "category",
                    "statement",
                    "sourceRefs",
                    "certainty",
                    "oracleIds"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "stateId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "stateId",
                    "title"
                  ],
                  "additionalProperties": false
                }
              },
              "transitions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "transitionId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "from": {
                      "type": "string",
                      "minLength": 1
                    },
                    "action": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "transitionId",
                    "from",
                    "action",
                    "to"
                  ],
                  "additionalProperties": false
                }
              },
              "observableOutcomes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "oracleId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ruleId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceRefs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    },
                    "contractAcceptanceCriteria": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "nodeId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "criterionIndex": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "nodeId",
                          "criterionIndex"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "oracleId",
                    "ruleId",
                    "statement",
                    "sourceRefs"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "applicability": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "dimension": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "required": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "dimension",
                    "value",
                    "required"
                  ],
                  "additionalProperties": false
                }
              },
              "sourceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "deprecated"
                ]
              }
            },
            "required": [
              "reqId",
              "revision",
              "title",
              "actors",
              "entities",
              "preconditions",
              "rules",
              "states",
              "transitions",
              "observableOutcomes",
              "applicability",
              "sourceRefs",
              "status"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "coupledDimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "applicabilityRules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "modelDecisionDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "modelRevision",
        "requirements",
        "coupledDimensions",
        "applicabilityRules",
        "modelDecisionDigest"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "artifactId",
    "artifactType",
    "schemaVersion",
    "engineVersion",
    "assetId",
    "prdRevision",
    "generationId",
    "createdAt",
    "contentDigest",
    "signatures",
    "dependencies",
    "graph",
    "content"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mutil-skills.local/e2e/schemas/requirement-model.schema.json",
  "title": "requirement-model artifact",
  "x-e2e-runtime-validation": {
    "required": true,
    "constraints": [
      "contentDigest、Authority 签名、dependency 与 graph 必须由 validateGeneration 校验"
    ]
  }
}
