{
  "type": "object",
  "properties": {
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "artifactType": {
      "type": "string",
      "const": "browser-action-map"
    },
    "schemaVersion": {
      "type": "string",
      "const": "2.1.0"
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "assetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._:-]+(?:\\/[A-Za-z0-9._:-]+)*$"
    },
    "prdRevision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "generationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "keyId": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "type": "string",
            "const": "Ed25519"
          },
          "signedDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "signature": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "issuer",
          "keyId",
          "algorithm",
          "signedDigest",
          "signature"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "artifactType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "schemaVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(?!\\/)(?!.*\\\\)(?!.*:)(?!.*\\/\\/)(?!.*\\/$)(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!(?:.*\\/)?(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:\\/|$))[^\\0/]+(?:\\/[^\\0/]+)*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactId",
          "artifactType",
          "schemaVersion",
          "relativePath",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "graph": {
      "type": "object",
      "properties": {
        "defines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        }
      },
      "required": [
        "defines",
        "references"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "actionMapRevision": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "pageIdentities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pageId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "origin": {
                "type": "string",
                "format": "uri"
              },
              "assertionDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "pageId",
              "origin",
              "assertionDigest"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "caseId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "stepId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "actionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "pageIdentityId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "locatorCandidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "strategy": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9._:-]+$"
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "strategy",
                    "value",
                    "confidence"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 32
              },
              "playwrightAction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "waits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9._:-]+$"
                    },
                    "timeoutMs": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 3600000
                    }
                  },
                  "required": [
                    "kind",
                    "timeoutMs"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 32
              },
              "oracleIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "minItems": 1,
                "maxItems": 1000
              },
              "effect": {
                "type": "string",
                "enum": [
                  "read",
                  "reversible-write",
                  "irreversible",
                  "unknown"
                ]
              },
              "runtimeHttpActionDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "operation": {
                      "type": "string",
                      "enum": [
                        "dom-read",
                        "screenshot",
                        "local-navigation",
                        "http-request",
                        "full-playwright"
                      ]
                    },
                    "capabilityId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9._:-]+$"
                    }
                  },
                  "required": [
                    "operation",
                    "capabilityId"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 16
              },
              "requestIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "maxItems": 1000,
                "uniqueItems": true
              }
            },
            "required": [
              "caseId",
              "stepId",
              "actionId",
              "pageIdentityId",
              "locatorCandidates",
              "playwrightAction",
              "waits",
              "oracleIds",
              "effect",
              "capabilities",
              "requestIds"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        },
        "unmappedSteps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "caseId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "stepId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "reasonCode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            },
            "required": [
              "caseId",
              "stepId",
              "reasonCode"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        },
        "discoveredRisks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low",
                  "info"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            },
            "required": [
              "code",
              "severity",
              "ref"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        },
        "executionProfile": {
          "type": "string",
          "enum": [
            "trusted-read-only",
            "trusted-reversible-write",
            "production-isolated",
            "full-playwright"
          ]
        },
        "fullPlaywrightPrograms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "string",
                "const": "full-playwright/v1"
              },
              "caseId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "stepId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "actionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1048576
              },
              "sourceDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "cleanupSource": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1048576
              },
              "cleanupSourceDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "dataLeaseId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "cleanupPlanId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "timeoutMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 3600000
              },
              "networkRequests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "intentId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9._:-]+$"
                    },
                    "method": {
                      "type": "string",
                      "pattern": "^[!#$%&'*+.^_`|~0-9A-Z-]{1,32}$"
                    },
                    "canonicalOrigin": {
                      "type": "string"
                    },
                    "exactPath": {
                      "type": "string"
                    },
                    "query": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "string"
                          }
                        ]
                      },
                      "maxItems": 1000
                    },
                    "payload": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "no-body"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "json"
                            },
                            "digest": {
                              "type": "string",
                              "pattern": "^sha256:[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "kind",
                            "digest"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "binary"
                            },
                            "digest": {
                              "type": "string",
                              "pattern": "^sha256:[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "kind",
                            "digest"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "template"
                            },
                            "templateDigest": {
                              "type": "string",
                              "pattern": "^sha256:[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "kind",
                            "templateDigest"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "targetFingerprint": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "headers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "pattern": "^[!#$%&'*+.^_`|~0-9a-z-]{1,128}$"
                          },
                          "value": {
                            "type": "string",
                            "maxLength": 8192
                          }
                        },
                        "required": [
                          "name",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 128
                    },
                    "maxRequests": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 1000
                    },
                    "expectedOrder": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 100000
                    }
                  },
                  "required": [
                    "intentId",
                    "method",
                    "canonicalOrigin",
                    "exactPath",
                    "query",
                    "payload",
                    "targetFingerprint",
                    "maxRequests",
                    "expectedOrder"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 10000
              }
            },
            "required": [
              "schemaVersion",
              "caseId",
              "stepId",
              "actionId",
              "source",
              "sourceDigest",
              "cleanupSource",
              "cleanupSourceDigest",
              "dataLeaseId",
              "cleanupPlanId",
              "timeoutMs",
              "networkRequests"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        }
      },
      "required": [
        "actionMapRevision",
        "pageIdentities",
        "actions",
        "unmappedSteps",
        "discoveredRisks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "artifactId",
    "artifactType",
    "schemaVersion",
    "engineVersion",
    "assetId",
    "prdRevision",
    "generationId",
    "createdAt",
    "contentDigest",
    "signatures",
    "dependencies",
    "graph",
    "content"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mutil-skills.local/e2e/schemas/browser-action-map.schema.json",
  "title": "browser-action-map artifact",
  "x-e2e-runtime-validation": {
    "required": true,
    "constraints": [
      "contentDigest、Authority 签名、dependency 与 graph 必须由 validateGeneration 校验",
      "actions.requestIds 必须在 action 内及 action 间唯一，并与 execution-contract 的 ReadHttpRequest/action 投影完全一致"
    ]
  }
}
