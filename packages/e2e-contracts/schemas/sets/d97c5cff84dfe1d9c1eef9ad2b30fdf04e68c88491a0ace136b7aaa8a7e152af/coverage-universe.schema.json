{
  "type": "object",
  "properties": {
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "artifactType": {
      "type": "string",
      "const": "coverage-universe"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "assetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._:-]+(?:\\/[A-Za-z0-9._:-]+)*$"
    },
    "prdRevision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "generationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "keyId": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "type": "string",
            "const": "Ed25519"
          },
          "signedDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "signature": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "issuer",
          "keyId",
          "algorithm",
          "signedDigest",
          "signature"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "artifactType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "schemaVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(?!\\/)(?!.*\\\\)(?!.*:)(?!.*\\/\\/)(?!.*\\/$)(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!(?:.*\\/)?(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:\\/|$))[^\\0/]+(?:\\/[^\\0/]+)*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifactId",
          "artifactType",
          "schemaVersion",
          "relativePath",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "graph": {
      "type": "object",
      "properties": {
        "defines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        }
      },
      "required": [
        "defines",
        "references"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "coveragePolicyDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pairwiseSeed": {
          "type": "integer",
          "minimum": 0
        },
        "universeDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "obligationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "reqId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "ruleIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "maxItems": 10000
              },
              "nodeIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "maxItems": 10000
              },
              "actor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[A-Za-z0-9._:-]+$"
                  },
                  {
                    "type": "string",
                    "const": "not-applicable"
                  }
                ]
              },
              "transitionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[A-Za-z0-9._:-]+$"
                  },
                  {
                    "type": "string",
                    "const": "not-applicable"
                  }
                ]
              },
              "scenario": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "necessity": {
                "type": "string",
                "enum": [
                  "required",
                  "advisory"
                ]
              },
              "applicabilityRuleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "disposition": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "automated"
                      },
                      "caseIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256,
                          "pattern": "^[A-Za-z0-9._:-]+$"
                        },
                        "minItems": 1,
                        "maxItems": 10000
                      }
                    },
                    "required": [
                      "kind",
                      "caseIds"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "manual"
                      },
                      "manualProcedureId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[A-Za-z0-9._:-]+$"
                      },
                      "blocking": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "kind",
                      "manualProcedureId",
                      "blocking"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "not-applicable"
                      },
                      "policyCode": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[A-Za-z0-9._:-]+$"
                      },
                      "rationale": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      },
                      "decisionGrantId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[A-Za-z0-9._:-]+$"
                      },
                      "decisionReceipt": {
                        "type": "object",
                        "properties": {
                          "schemaVersion": {
                            "type": "string",
                            "const": "1.0.0"
                          },
                          "decisionId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256,
                            "pattern": "^[A-Za-z0-9._:-]+$"
                          },
                          "decisionStatus": {
                            "type": "string",
                            "enum": [
                              "approved",
                              "rejected"
                            ]
                          },
                          "decisionSubjectDigest": {
                            "type": "string",
                            "pattern": "^sha256:[a-f0-9]{64}$"
                          },
                          "checkedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "nonce": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "approver": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "subject": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 256,
                                    "pattern": "^[A-Za-z0-9._:-]+$"
                                  },
                                  "roles": {
                                    "type": "array",
                                    "items": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 256,
                                      "pattern": "^[A-Za-z0-9._:-]+$"
                                    },
                                    "minItems": 1,
                                    "maxItems": 64
                                  }
                                },
                                "required": [
                                  "subject",
                                  "roles"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "type": "string",
                                    "const": "local-caller"
                                  }
                                },
                                "required": [
                                  "kind"
                                ],
                                "additionalProperties": false
                              }
                            ]
                          },
                          "issuer": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256,
                            "pattern": "^[A-Za-z0-9._:-]+$"
                          },
                          "keyId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256,
                            "pattern": "^[A-Za-z0-9._:-]+$"
                          },
                          "algorithm": {
                            "type": "string",
                            "const": "Ed25519"
                          },
                          "signedDigest": {
                            "type": "string",
                            "pattern": "^sha256:[a-f0-9]{64}$"
                          },
                          "signature": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          "kind": {
                            "type": "string",
                            "const": "coverage-disposition"
                          },
                          "purpose": {
                            "type": "string",
                            "const": "coverage-disposition-decision-receipt/v1"
                          }
                        },
                        "required": [
                          "schemaVersion",
                          "decisionId",
                          "decisionStatus",
                          "decisionSubjectDigest",
                          "checkedAt",
                          "nonce",
                          "approver",
                          "issuer",
                          "keyId",
                          "algorithm",
                          "signedDigest",
                          "signature",
                          "kind",
                          "purpose"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "kind",
                      "policyCode",
                      "rationale",
                      "decisionGrantId",
                      "decisionReceipt"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "obligationId",
              "reqId",
              "ruleIds",
              "nodeIds",
              "actor",
              "transitionId",
              "scenario",
              "necessity",
              "applicabilityRuleId",
              "disposition"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        }
      },
      "required": [
        "coveragePolicyDigest",
        "pairwiseSeed",
        "universeDigest",
        "obligations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "artifactId",
    "artifactType",
    "schemaVersion",
    "engineVersion",
    "assetId",
    "prdRevision",
    "generationId",
    "createdAt",
    "contentDigest",
    "signatures",
    "dependencies",
    "graph",
    "content"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mutil-skills.local/e2e/schemas/coverage-universe.schema.json",
  "title": "coverage-universe artifact",
  "x-e2e-runtime-validation": {
    "required": true,
    "constraints": [
      "contentDigest、Authority 签名、dependency 与 graph 必须由 validateGeneration 校验"
    ]
  }
}
