{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutil-skills.local/schemas/skill.manifest.schema.json",
  "title": "Skill Manifest",
  "type": "object",
  "required": ["id", "name", "source", "requires"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["type", "url", "rawUrl", "ref"],
      "properties": {
        "type": { "const": "github" },
        "url": { "type": "string", "format": "uri" },
        "rawUrl": { "type": "string", "format": "uri" },
        "ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["capability", "satisfiedBy", "whenMissing"],
            "properties": {
              "capability": { "const": "foundation.testing" },
              "satisfiedBy": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "whenMissing": {
                "type": "object",
                "required": ["action", "package", "import"],
                "properties": {
                  "action": { "const": "prompt-install" },
                  "package": { "type": "string", "minLength": 1 },
                  "import": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["capability", "satisfiedBy", "whenMissing"],
            "properties": {
              "capability": {
                "enum": [
                  "e2e.contracts", "e2e.engine", "e2e.authority", "e2e.gateway",
                  "browser.chromium", "e2e.report", "e2e.sanitizer", "artifact.posix-local-fs"
                ]
              },
              "satisfiedBy": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "whenMissing": {
                "type": "object",
                "required": ["action", "terminalState", "reasonCode"],
                "properties": {
                  "action": { "const": "block" },
                  "terminalState": {
                    "enum": [
                      "input-blocked", "environment-blocked", "safety-blocked",
                      "artifact-blocked", "migration-required"
                    ]
                  },
                  "reasonCode": { "type": "string", "pattern": "^E2E_[A-Z0-9_]+$" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["capability", "satisfiedBy", "whenMissing"],
            "properties": {
              "capability": { "const": "e2e.runtime-host" },
              "satisfiedBy": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "whenMissing": {
                "type": "object",
                "required": ["action", "package", "version", "terminalState", "reasonCode"],
                "properties": {
                  "action": { "const": "prompt-install" },
                  "package": { "const": "@mutil-skills/e2e-runtime" },
                  "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
                  "terminalState": { "const": "environment-blocked" },
                  "reasonCode": { "const": "E2E_RUNTIME_HOST_UNAVAILABLE" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "templateReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
