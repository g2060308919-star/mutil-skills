{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutil-skills.local/schemas/skill.manifest.schema.json",
  "title": "Skill Manifest",
  "type": "object",
  "required": ["id", "name", "source", "requires"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["type", "url", "rawUrl", "ref"],
      "properties": {
        "type": { "const": "github" },
        "url": { "type": "string", "format": "uri" },
        "rawUrl": { "type": "string", "format": "uri" },
        "ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "satisfiedBy", "whenMissing"],
        "properties": {
          "capability": { "const": "foundation.testing" },
          "satisfiedBy": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "whenMissing": {
            "type": "object",
            "required": ["action", "package", "import"],
            "properties": {
              "action": { "const": "prompt-install" },
              "package": { "type": "string", "minLength": 1 },
              "import": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "templateReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
